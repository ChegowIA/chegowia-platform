# Copie para .env.production, restrinja para chmod 600 e preencha fora do Git.
NODE_ENV=production
TZ=America/Sao_Paulo
BUSINESS_TIMEZONE=America/Sao_Paulo
DOMAIN=chegowia.com.br
TLS_EMAIL=contato@chegowia.com.br
DATA_ROOT=/srv/chegowia/data
# Relato de erro para fora da máquina. Sem SENTRY_DSN o erro fica só no log do
# container — e quem descobre a falha é o cliente, ligando. Corpo de requisição,
# cabeçalho, cookie e dado de usuário são removidos antes do envio.
SENTRY_DSN=
SENTRY_ENVIRONMENT=producao
APP_VERSION=

BACKUP_ROOT=/srv/chegowia/backups
BACKUP_RETENTION_DAYS=14
# Para onde a cópia sai do servidor. Backup que mora no mesmo disco do banco não
# é backup: disco morto, incêndio ou conta encerrada levam os dois juntos — e
# aqui há nota fiscal com guarda obrigatória de cinco anos.
# Escolha um dos dois. Sem nenhum, infra/backup.sh avisa e sai com erro.
#   BACKUP_REMOTE: remoto do rclone. Prefira um do tipo `crypt`, que cifra antes
#   de a cópia sair da máquina.
BACKUP_REMOTE=
#   BACKUP_RSYNC_TARGET: outra máquina por SSH, como usuario@host:/srv/backups.
BACKUP_RSYNC_TARGET=
# Ficar só com o backup local é uma decisão possível, mas tem de ser dita em voz
# alta: sem isto o script sai com erro toda noite. Conviver com alerta vermelho
# de backup é pior do que assumir o risco por escrito, porque treina a ignorar
# exatamente o aviso que um dia vai importar.
BACKUP_ALLOW_LOCAL_ONLY=false
# Exige conexão cifrada no dump quando o banco é remoto. Deixe true: o dump leva
# endereço de cliente, CPF e CNPJ pela internet. Só desligue se o banco recusar
# TLS, sabendo que aí o tráfego passa em texto claro.
BACKUP_REQUIRE_TLS=true

MYSQL_ROOT_PASSWORD=GERAR_UMA_SENHA_EXCLUSIVA_FORTE
MYSQL_DATABASE=chegowia
MYSQL_USER=chegowia
MYSQL_PASSWORD=GERAR_OUTRA_SENHA_EXCLUSIVA_FORTE

# O Compose substitui o host do banco por mysql; este valor atende validações auxiliares.
DATABASE_URL=mysql://chegowia:SENHA_URL_ENCODED@mysql:3306/chegowia
HOST=0.0.0.0
PORT=3001
APP_URL=https://chegowia.com.br
API_PUBLIC_URL=https://chegowia.com.br
CORS_ORIGIN=https://chegowia.com.br
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=GERAR_COM_OPENSSL_RAND_BASE64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=chegowia-api
JWT_AUDIENCE=chegowia-web
# MFA é obrigatório para todas as contas reais; a aplicação não permite
# reduzir esta proteção por cargo. Variável legada mantida apenas para não
# quebrar ambientes já criados.
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN,FUNCIONARIO,COZINHA,MOTOBOY,GARCOM,CLIENTE,REVENDEDOR
BILLING_ENFORCEMENT=true
ENABLE_SWAGGER=false

UPLOAD_ROOT=/data/uploads
PRIVATE_UPLOAD_ROOT=/data/private_uploads
CLAMAV_SCAN_ENABLED=true
CLAMAV_COMMAND=clamdscan
CLAMAV_CONFIG_PATH=/etc/clamav/clamd-client.conf
CLAMAV_TIMEOUT_MS=30000
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb

# Informe endpoints de um provedor contratado ou de instâncias próprias.
# Não use os serviços públicos de demonstração para alto volume em produção.
GEOCODING_BASE_URL=https://SEU_PROVEDOR_DE_GEOCODING/search
ROUTING_BASE_URL=https://SEU_PROVEDOR_DE_ROTAS/route/v1/driving
# Fallback de coordenadas por CEP quando a busca exata não localizar o endereço.
BRASILAPI_CEP_BASE_URL=https://brasilapi.com.br/api/cep/v2
GEOCODING_USER_AGENT=ChegowIA/1.0 (contato@chegowia.com.br)
GEOCODING_MIN_INTERVAL_MS=1100
GEOGRAPHY_REQUEST_TIMEOUT_MS=8000
# URL de tiles usada no seletor interativo de localização do cliente/loja.
# Para operação comercial em escala, configure um provedor com SLA próprio.
# Deve conter {z}/{x}/{y}; a atribuição OpenStreetMap é exibida no mapa.
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=re_sua_chave_da_resend
MAIL_FROM="ChegowIA <contato@chegowia.com.br>"
# Caixa da equipe de operação — NÃO é caixa de lojista. Recebe os avisos de
# evento Stripe que esgotou tentativas, repasse encerrado sem confirmação e
# NFC-e que não foi transmitida. Sem alguém lendo, uma fatura paga que não
# virou acesso só aparece se alguém abrir /super-admin/operacao por conta.
OPS_ALERT_EMAIL=operacao@chegowia.com.br

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=PREENCHER_COM_NOVA_CHAVE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Prospecção QR: chave de sessão exclusiva em .env.outreach, não neste arquivo.

# WhatsApp pelo Gupshup. Ao habilitar, a API exige todos os segredos abaixo e um
# API_PUBLIC_URL HTTPS para receber o callback.
GUPSHUP_ENABLED=false
GUPSHUP_MODE=SELF_SERVE
GUPSHUP_API_BASE_URL=https://api.gupshup.io
GUPSHUP_API_KEY=PREENCHER_COM_APIKEY_DA_CONTA_GUPSHUP
# O Gupshup não assina o corpo do callback: este segredo, embutido na URL
# registrada no painel deles, é a única prova de origem. Trocá-lo exige
# atualizar a URL do webhook no mesmo momento, senão o callback passa a dar 401.
GUPSHUP_WEBHOOK_TOKEN=GERAR_COM_OPENSSL_RAND_HEX_32
# Cifra o token de cada aplicativo em repouso. Trocar torna ilegíveis os canais
# já conectados — só reconectando cada número.
WHATSAPP_TOKEN_ENCRYPTION_KEY=GERAR_COM_OPENSSL_RAND_BASE64_32

# Fiscal — cifra o certificado digital A1 e o CSC em repouso.
# Chave PRÓPRIA: o boot recusa se for igual à do WhatsApp. Sob ela está a chave
# privada com que se assina documento fiscal em nome da empresa; compartilhar a
# cifragem faria um vazamento virar dois.
# Perder esta chave torna ilegíveis os certificados já enviados — cada lojista
# teria de reenviar o arquivo. Guarde-a FORA do mesmo lugar do backup do banco.
FISCAL_ENCRYPTION_KEY=GERAR_COM_OPENSSL_RAND_BASE64_32

# Papel do processo. O Compose já define api/worker por serviço; deixe vazio.
APP_ROLE=

# Réplicas da API. Maior que 1 falha o boot: o limite de requisições é contado
# na memória de cada processo e N réplicas multiplicariam o limite por N.
API_REPLICAS=1

# Token para raspar /api/health/metrics (Prometheus). Vazio desliga a rota —
# ela expõe volume de pedidos e latência, que é informação comercial.
METRICS_TOKEN=

# Cobrança pelo Asaas. Trocar para STRIPE volta a exigir as três chaves abaixo.
BILLING_PROVIDER=ASAAS
ASAAS_API_KEY=$aact_prod_PREENCHER
ASAAS_WEBHOOK_TOKEN=GERAR_TOKEN_ALEATORIO_MIN_20_CHARS
# Opcional: 32 bytes em base64/hex para cifrar a chave da subconta do revendedor.
ASAAS_SUBACCOUNT_ENCRYPTION_KEY=
# A comissão de 30% só é liberada quando o Asaas credita a cobrança na conta
# raiz. Mantenha 0 para não somar uma reserva ao prazo de compensação.
ASAAS_COMMISSION_POST_RECEIPT_HOLD_DAYS=0

# Preencha apenas se ainda houver assinatura sendo cobrada pela Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Usadas uma única vez pelo seed inicial. Troque a senha após o primeiro acesso.
SEED_SUPER_ADMIN_EMAIL=contato@chegowia.com.br
SEED_SUPER_ADMIN_PASSWORD=GERAR_SENHA_INICIAL_FORTE
SEED_DEMO_DATA=false
