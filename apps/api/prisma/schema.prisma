generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (manter em sincronia com packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  FUNCIONARIO
  COZINHA
  MOTOBOY
  GARCOM
  CLIENTE
  REVENDEDOR
}

enum OrderStatus {
  RECEBIDO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum DeliveryStatus {
  AGUARDANDO_RETIRADA
  RETIRADO
  EM_ROTA
  ENTREGUE
  PROBLEMA
}

enum DeliveryProblemReason {
  CLIENTE_NAO_ATENDEU
  ENDERECO_NAO_LOCALIZADO
  CLIENTE_RECUSOU
  VEICULO_COM_PROBLEMA
  PEDIDO_DANIFICADO
  AREA_DE_RISCO
  OUTRO
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_ENTREGA
  PIX_MANUAL
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
}

// A origem fica fotografada no pedido para que operação, relatórios e suporte
// distingam uma compra feita pelo site de uma compra assistida no WhatsApp.
enum OrderSource {
  SITE
  WHATSAPP
}

enum PromotionStatus {
  RASCUNHO
  PENDENTE_CONFIRMACAO
  ATIVA
  ENCERRADA
}

enum AIAgentRole {
  OPERACIONAL
  ATENDIMENTO
  ONBOARDING
}

enum AIChannel {
  INTERNO
  CLIENTE
  WHATSAPP
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MessagingChannelType {
  WHATSAPP
}

enum MessagingChannelStatus {
  ATIVO
  INATIVO
}

// BSP responsável pelo número. Só o Gupshup, que atende via Passthrough APIs —
// elas imitam o formato da Meta no envio e no webhook, o que mantém um único
// parser de conversa. O enum permanece para que trocar de BSP no futuro não
// exija migrar dado histórico.
enum WhatsAppProvider {
  GUPSHUP
}

enum WhatsAppConversationMode {
  VIRTUAL
  HUMANO
}

enum WhatsAppConversationStatus {
  ABERTA
  ENCERRADA
}

enum WhatsAppMessageDirection {
  RECEBIDA
  ENVIADA
}

enum WhatsAppMessageStatus {
  RECEBIDA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

// Prospecção ativa pelo número institucional.
//
// RASCUNHO existe porque a lista é conferida antes de sair: o disparo começa
// só quando alguém olha quantos números foram aceitos, quantos eram repetidos e
// quantos estavam na lista de não contatar.
enum OutreachCampaignStatus {
  RASCUNHO
  ENVIANDO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

// PENDENTE -> ENVIADO -> RESPONDEU é o caminho feliz. DESCARTADO é o número que
// entrou na lista mas nunca deve receber nada (repetido, inválido ou bloqueado),
// e fica registrado em vez de ser apagado para o relatório do disparo fechar.
enum OutreachTargetStatus {
  PENDENTE
  ENVIADO
  RESPONDEU
  FALHOU
  DESCARTADO
}

// Atendimento autenticado da própria ChegowIA. Ele não pertence a nenhuma
// Company: é a ponte entre qualquer pessoa logada e a equipe da plataforma.
// Mantê-lo fora das conversas operacionais evita que dados de suporte sejam
// filtrados, expostos ou faturados como se fossem de uma empresa cliente.
enum PlatformSupportConversationMode {
  IA
  HUMANO
}

enum PlatformSupportConversationStatus {
  ABERTA
  ENCERRADA
}

enum PlatformSupportMessageRole {
  USUARIO
  ASSISTENTE
  SUPER_ADMIN
  SISTEMA
}

// Carrinho persistente do atendimento automatizado. O pedido só é criado após
// a confirmação explícita do cliente; até lá, endereço, itens e orçamento
// permanecem neste rascunho isolado pela empresa e pela conversa.
enum WhatsAppOrderDraftStatus {
  MONTANDO
  AGUARDANDO_CONFIRMACAO
  CONCLUIDO
  CANCELADO
}

enum UsageSource {
  IA
  WHATSAPP
}

enum UsageMetric {
  IA_TOKENS_ENTRADA
  IA_TOKENS_ENTRADA_CACHE
  IA_TOKENS_SAIDA
  WHATSAPP_SERVICO
  WHATSAPP_TEMPLATE_UTILIDADE
  WHATSAPP_TEMPLATE_MARKETING
  WHATSAPP_TEMPLATE_AUTENTICACAO
}

enum UsageLedgerStatus {
  PENDENTE
  SINCRONIZADO
  FATURADO
  FALHOU
}

// A planilha nunca cria produtos diretamente. Ela gera uma sessão curta de
// revisão, vinculada à empresa e à pessoa que a enviou, antes da publicação
// explícita no cardápio.
enum CatalogImportStatus {
  PENDENTE
  APLICADO
  EXPIRADO
}

enum TableStatus {
  LIVRE
  OCUPADA
  RESERVADA
  INATIVA
}

enum TableSessionStatus {
  ABERTA
  FECHADA
  CANCELADA
}

enum DiningOrderStatus {
  RECEBIDO
  EM_PREPARO
  PRONTO
  SERVIDO
  CANCELADO
}

// Origem da rodada lançada na comanda. Mantemos esse contexto para a equipe
// identificar imediatamente o que foi pedido pelo QR da própria mesa.
enum DiningOrderSource {
  EQUIPE
  QR_MESA
}

enum ApplicationStatus {
  EM_ANALISE_IA
  RECUSADA_IA
  REVISAO_HUMANA
  APROVADA
  RECUSADA
}

enum SubscriptionStatus {
  PENDENTE
  EM_TESTE
  ATIVA
  INADIMPLENTE
  CANCELADA
}

enum CommissionStatus {
  PENDENTE
  PROCESSANDO
  DISPONIVEL
  PAGA
  ESTORNADA
}

enum PayoutBatchStatus {
  PROCESSANDO
  PAGO
  FALHOU
}

/// Provedor de cobrança de um evento ou assinatura. Os dois convivem durante a
/// migração: o Stripe segue atendendo quem já assinou até a última assinatura
/// dele terminar.
enum BillingProvider {
  STRIPE
  ASAAS
}

enum StripeEventStatus {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  FALHOU
}

enum AccountTokenType {
  VERIFICACAO_EMAIL
  REDEFINICAO_SENHA
  LOGIN_MFA
}

enum IdentityDocumentOwnerType {
  USER
  COMPANY
}

enum LeadStatus {
  DISPONIVEL
  EM_ATENDIMENTO
  PROPOSTA
  CONVERTIDO
  PERDIDO
}

// Regime tributário da empresa. Define o motor de cálculo (CSOSN no Simples,
// CST nos demais) e é obrigatório no XML da NFC-e.
enum TaxRegime {
  SIMPLES_NACIONAL
  SIMPLES_NACIONAL_EXCESSO
  REGIME_NORMAL
}

// Ambiente da SEFAZ. Homologação é o padrão e emite documento sem valor
// fiscal; produção é liberada só depois da homologação do estado.
enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

// Origem da mercadoria (tabela A do CST). O dígito que vai no XML está em
// packages/shared/src/fiscal.ts — aqui fica o nome para o código ser legível.
enum TaxOrigin {
  NACIONAL
  ESTRANGEIRA_IMPORTACAO_DIRETA
  ESTRANGEIRA_MERCADO_INTERNO
  NACIONAL_IMPORTACAO_ACIMA_40
  NACIONAL_PROCESSOS_BASICOS
  NACIONAL_IMPORTACAO_ATE_40
  ESTRANGEIRA_IMPORTACAO_SEM_SIMILAR
  ESTRANGEIRA_MERCADO_INTERNO_SEM_SIMILAR
  NACIONAL_IMPORTACAO_ACIMA_70
}

// Ciclo de vida da NFC-e. RASCUNHO existe porque a numeração é reservada antes
// do envio: número queimado sem documento é inutilização pendente, não buraco
// silencioso na sequência.
enum FiscalDocumentStatus {
  RASCUNHO
  ASSINADA
  ENVIANDO
  AUTORIZADA
  REJEITADA
  DENEGADA
  CANCELADA
  CONTINGENCIA
  INUTILIZADA
}

// tpEmis do layout: 1 normal, 9 contingência offline da NFC-e.
enum FiscalEmissionType {
  NORMAL
  CONTINGENCIA_OFFLINE
}

enum FiscalEventType {
  CANCELAMENTO
  CARTA_CORRECAO
  INUTILIZACAO
}

enum FiscalEventStatus {
  PENDENTE
  REGISTRADO
  REJEITADO
}

enum CashSessionStatus {
  ABERTO
  FECHADO
}

// Sangria retira dinheiro do caixa, suprimento coloca. Os dois precisam de
// registro porque o fechamento confere o esperado contra o contado.
enum CashMovementType {
  SANGRIA
  SUPRIMENTO
  AJUSTE
}

enum FiscalCertificateStatus {
  ATIVO
  SUBSTITUIDO
  REVOGADO
}

// ---------------------------------------------------------------------------
// Identidade / plataforma
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  document          String?   @unique
  passwordHash      String
  role              Role
  avatarUrl         String?
  isActive          Boolean   @default(true)
  emailVerifiedAt   DateTime?
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  companyId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  refreshTokens              RefreshToken[]
  accountTokens              AccountToken[]
  superAdminCompanyAccesses  SuperAdminCompanyAccess[]  @relation("SuperAdminCompanyAccessActor")
  superAdminResellerAccesses SuperAdminResellerAccess[] @relation("SuperAdminResellerAccessActor")
  employeeProfile            EmployeeProfile?
  customerProfiles           CustomerProfile[]
  addresses                  Address[]

  ordersAsCustomer              Order[]                       @relation("OrderCustomer")
  orderStatusChanges            OrderStatusHistory[]          @relation("OrderStatusChangedBy")
  deliveriesAsMotoboy           Delivery[]                    @relation("DeliveryMotoboy")
  aiConversations               AIConversation[]              @relation("AIConversationUser")
  aiActionsConfirmed            AIActionLog[]                 @relation("AIActionConfirmedBy")
  whatsappConversationsAssigned WhatsAppConversation[]        @relation("WhatsAppConversationAssignedTo")
  whatsappMessagesSent          WhatsAppMessage[]             @relation("WhatsAppMessageSentBy")
  tableSessionsOpened           TableSession[]                @relation("TableSessionOpenedBy")
  tableSessionsAttending        TableSession[]                @relation("TableSessionAttendant")
  tableSessionsClosed           TableSession[]                @relation("TableSessionClosedBy")
  diningOrdersCreated           DiningOrder[]                 @relation("DiningOrderCreatedBy")
  resellerProfile               ResellerProfile?
  resellerApplicationsReviewed  ResellerApplication[]         @relation("ResellerApplicationReviewedBy")
  leadsClaimed                  SalesLead[]                   @relation("SalesLeadClaimedBy")
  platformSupportConversations  PlatformSupportConversation[] @relation("PlatformSupportUser")
  platformSupportAssigned       PlatformSupportConversation[] @relation("PlatformSupportAssignedSuperAdmin")
  platformSupportMessages       PlatformSupportMessage[]      @relation("PlatformSupportMessageAuthor")

  @@index([companyId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  // Contexto assumido pelo superadmin multiacesso. Fica aqui para que renovar a
  // sessão não devolva silenciosamente o usuário ao papel de plataforma —
  // trocar de contexto seria desfeito a cada refresh.
  assumedRole       Role?
  assumedCompanyId  String?
  // Sessões de suporte por atalho carregam o ID auditável que as originou.
  // Não é uma FK de propósito: o histórico do atalho não pode ser apagado por
  // uma rotação normal de refresh token.
  assumedAccessId   String?
  // Tipo e sujeito do acesso auditado. São necessários para renovar uma visão
  // de revendedor sem jamais trocar a identidade real (`userId`) da sessão.
  // "COMPANY" ou "RESELLER". A largura acompanha a coluna criada em
  // 20260814003000: sem ela declarada, o Prisma acha que o campo tem 191
  // caracteres e a próxima migration gerada alargaria a coluna sem motivo.
  assumedAccessKind String? @db.VarChar(20)
  assumedUserId     String?
  assumedResellerId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assumedAccessId])
  @@index([assumedResellerId])
}

// Atalho efêmero e auditável para o superadmin abrir a visão ADMIN de uma
// empresa. O segredo cru só existe no fragmento da URL no navegador; o banco
// guarda apenas o SHA-256. Depois de consumido, o mesmo registro vira a trilha
// de auditoria da sessão de suporte.
model SuperAdminCompanyAccess {
  id               String    @id @default(cuid())
  companyId        String
  superAdminId     String
  tokenHash        String    @unique
  linkExpiresAt    DateTime
  sessionExpiresAt DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  superAdmin User    @relation("SuperAdminCompanyAccessActor", fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([superAdminId, sessionExpiresAt])
}

// Equivalente ao acesso de empresa, mas para a área de parceiros. A sessão
// resultante é explicitamente de leitura para que suporte não mova dinheiro,
// crie vendas ou altere a carteira comercial em nome do revendedor.
model SuperAdminResellerAccess {
  id               String    @id @default(cuid())
  resellerId       String
  superAdminId     String
  tokenHash        String    @unique
  linkExpiresAt    DateTime
  sessionExpiresAt DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  reseller   ResellerProfile @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  superAdmin User            @relation("SuperAdminResellerAccessActor", fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([resellerId, createdAt])
  @@index([superAdminId, sessionExpiresAt])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model IdentityDocument {
  value     String                    @id
  ownerType IdentityDocumentOwnerType
  ownerId   String                    @unique
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([ownerType])
}

// ---------------------------------------------------------------------------
// Empresa (tenant)
// ---------------------------------------------------------------------------

model Company {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  cnpj                   String?  @unique
  phone                  String?
  whatsapp               String?
  addressLine            String?
  city                   String?
  state                  String?
  latitude               Decimal? @db.Decimal(10, 7)
  longitude              Decimal? @db.Decimal(10, 7)
  deliveryFeeBase        Decimal  @default(0) @db.Decimal(10, 2)
  deliveryFeePerKm       Decimal  @default(1.50) @db.Decimal(10, 2)
  deliveryRadiusKm       Decimal  @default(10) @db.Decimal(6, 2)
  avgDeliveryTimeMinutes Int      @default(40)
  logoUrl                String?
  isActive               Boolean  @default(true)
  // Empresas criadas durante a homologação ficam fora da vitrine pública até
  // o modo temporário ser desligado. Não substitui isActive: a operação segue
  // funcionando normalmente para o administrador da própria empresa.
  isTestOnly             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  settings                  CompanySettings?
  users                     User[]
  deliveryAreas             DeliveryArea[]
  categories                Category[]
  products                  Product[]
  catalogImportSessions     CatalogImportSession[]
  orders                    Order[]
  deliveries                Delivery[]
  payments                  Payment[]
  employeeProfiles          EmployeeProfile[]
  customerProfiles          CustomerProfile[]
  promotions                Promotion[]
  messagingChannels         MessagingChannel[]
  whatsappConversations     WhatsAppConversation[]
  whatsappMessages          WhatsAppMessage[]
  whatsappOrderDrafts       WhatsAppOrderDraft[]
  usageLedgers              UsageLedger[]
  aiConversations           AIConversation[]
  aiActionLogs              AIActionLog[]
  restaurantTables          RestaurantTable[]
  tableSessions             TableSession[]
  diningOrders              DiningOrder[]
  subscription              ClientSubscription?
  clientApplication         ClientApplication?
  fiscalProfile             CompanyFiscalProfile?
  fiscalCertificates        FiscalCertificate[]
  fiscalDocuments           FiscalDocument[]
  cashRegisters             CashRegister[]
  cashSessions              CashSession[]
  superAdminCompanyAccesses SuperAdminCompanyAccess[]

  @@index([city, state])
  @@index([isActive, isTestOnly, city, state])
}

// ---------------------------------------------------------------------------
// Fiscal
// ---------------------------------------------------------------------------

// Cadastro fiscal da empresa: o que a SEFAZ exige no emitente da NFC-e e que
// não cabe no cadastro comercial. Fica separado de `Company` de propósito —
// são dados de responsabilidade contábil, alterados por outro papel e com
// outro ciclo de vida.
//
// O endereço aqui é o **fiscal** (o do CNPJ), que pode divergir do endereço de
// contato mostrado ao cliente. `cityIbgeCode` é o código do IBGE de 7 dígitos,
// obrigatório no XML — não dá para derivar do nome da cidade com segurança.
model CompanyFiscalProfile {
  id                    String            @id @default(cuid())
  companyId             String            @unique
  taxRegime             TaxRegime
  // CNAE principal, 7 dígitos, sem máscara.
  cnae                  String            @db.VarChar(7)
  // Inscrição estadual; "ISENTO" quando a empresa é isenta.
  stateRegistration     String            @db.VarChar(20)
  municipalRegistration String?           @db.VarChar(20)
  legalName             String
  tradeName             String?
  addressStreet         String
  addressNumber         String            @db.VarChar(20)
  addressComplement     String?
  addressDistrict       String
  cityIbgeCode          String            @db.VarChar(7)
  cityName              String
  state                 String            @db.VarChar(2)
  zipCode               String            @db.VarChar(8)
  environment           FiscalEnvironment @default(HOMOLOGACAO)
  // Série e próximo número da NFC-e. A numeração é por empresa e por série.
  nfceSeries            Int               @default(1)
  nfceNextNumber        Int               @default(1)
  // Emissão automática ao marcar pedido como pago ou fechar comanda de mesa.
  // Desligada por padrão: ligar antes de homologar na SEFAZ produziria
  // rejeição a cada venda.
  autoEmit              Boolean           @default(false)
  // Identificador do CSC (token do QR Code) fornecido pela SEFAZ.
  cscId                 String?           @db.VarChar(6)
  // CSC cifrado em repouso — é segredo, nunca sai em resposta nem em log.
  cscTokenEncrypted     String?           @db.Text
  // Última conversa real com a SEFAZ (consulta de status do serviço). É a
  // única prova, antes de emitir, de que o certificado é aceito no TLS mútuo e
  // de que o endpoint do estado responde — sem gastar numeração.
  sefazCheckedAt        DateTime?
  sefazCheckStatus      String?           @db.VarChar(10)
  sefazCheckReason      String?           @db.Text

  // Padrões fiscais do cardápio. Um restaurante tem centenas de itens e quase
  // todos compartilham a mesma tributação; obrigar o preenchimento produto a
  // produto garantiria cadastro incompleto ou copiado errado. O produto só
  // guarda o que difere daqui.
  defaultNcm        String?   @db.VarChar(8)
  defaultCest       String?   @db.VarChar(7)
  defaultCfop       String    @default("5102") @db.VarChar(4)
  defaultTaxOrigin  TaxOrigin @default(NACIONAL)
  // CSOSN no Simples, CST nos demais — validado contra o regime da empresa.
  defaultIcmsCode   String?   @db.VarChar(3)
  defaultIcmsRate   Decimal?  @db.Decimal(5, 2)
  // Percentual de redução da base de cálculo. Só o CST 20 usa, e para ele é
  // obrigatório no XML: sem o pRedBC a nota é recusada pelo schema.
  defaultIcmsReductionRate Decimal? @db.Decimal(5, 2)
  defaultPisCode    String?   @db.VarChar(2)
  defaultPisRate    Decimal?  @db.Decimal(5, 2)
  defaultCofinsCode String?   @db.VarChar(2)
  defaultCofinsRate Decimal?  @db.Decimal(5, 2)
  defaultUnit       String    @default("UN") @db.VarChar(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Certificado digital A1 (arquivo .pfx/.p12 + senha).
//
// O arquivo e a senha ficam cifrados com AES-256-GCM no banco, nunca em disco:
// o container roda com sistema de arquivos somente leitura e um .pfx em disco
// é a chave privada da empresa esperando para vazar. Os metadados (titular,
// emissor, validade) são extraídos no upload para permitir o alerta de
// expiração sem precisar decifrar nada.
//
// O histórico é preservado — trocar o certificado marca o anterior como
// SUBSTITUIDO em vez de apagar, porque documentos já emitidos foram assinados
// por ele e a auditoria precisa saber com qual.
// NFC-e emitida (ou tentada).
//
// Guarda o XML assinado e o protocolo de autorização porque a lei exige a
// guarda por cinco anos e porque, sem o XML original, um cancelamento ou uma
// consulta posterior não tem como ser montado. `accessKey` é a chave de 44
// dígitos e é única no sistema inteiro — número repetido é rejeição na SEFAZ.
model FiscalDocument {
  id             String               @id @default(cuid())
  companyId      String
  // Sem unicidade: uma venda pode acumular mais de um documento ao longo da
  // vida — a tentativa rejeitada fica registrada com o número que queimou (é
  // dela que sai a inutilização) e a reemissão nasce como documento novo. A
  // idempotência do botão "emitir" é garantida no serviço, que recusa emitir
  // quando já existe documento vivo para a mesma venda.
  orderId        String?
  tableSessionId String?
  status         FiscalDocumentStatus @default(RASCUNHO)
  emissionType   FiscalEmissionType   @default(NORMAL)
  environment    FiscalEnvironment
  series         Int
  number         Int
  accessKey      String?              @unique @db.VarChar(44)
  // Código numérico aleatório (cNF) e dígito verificador, guardados porque
  // entram na chave e precisam ser reproduzidos em qualquer reenvio.
  numericCode    String               @db.VarChar(8)
  issuedAt       DateTime
  totalAmount    Decimal              @db.Decimal(10, 2)
  icmsAmount     Decimal              @default(0) @db.Decimal(10, 2)
  pisAmount      Decimal              @default(0) @db.Decimal(10, 2)
  cofinsAmount   Decimal              @default(0) @db.Decimal(10, 2)
  xml            String?              @db.LongText
  protocolXml    String?              @db.LongText
  protocolNumber String?              @db.VarChar(20)
  authorizedAt   DateTime?
  qrCodeUrl      String?              @db.Text
  // Código e motivo da SEFAZ, mais a versão traduzida para o lojista.
  statusCode     String?              @db.VarChar(10)
  statusReason   String?              @db.Text
  actionHint     String?              @db.Text
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  alertedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order        Order?                @relation(fields: [orderId], references: [id])
  // FK composta: documento de uma empresa não pode apontar para a comanda de
  // outra, mesmo que uma escrita externa ao serviço erre os IDs.
  tableSession TableSession?         @relation("FiscalDocumentTableSession", fields: [tableSessionId, companyId], references: [id, companyId], onDelete: Restrict)
  events       FiscalDocumentEvent[]

  @@unique([companyId, environment, series, number])
  @@index([orderId])
  @@index([tableSessionId, companyId])
  @@index([companyId, status, createdAt])
  @@index([status, nextAttemptAt])
}

// Cancelamento, carta de correção e inutilização. Ficam separados do documento
// porque um mesmo documento pode ter vários, e porque a inutilização não tem
// documento nenhum — só uma faixa de numeração queimada.
model FiscalDocumentEvent {
  id              String            @id @default(cuid())
  companyId       String
  documentId      String?
  type            FiscalEventType
  status          FiscalEventStatus @default(PENDENTE)
  sequence        Int               @default(1)
  reason          String            @db.Text
  // Faixa usada só na inutilização.
  rangeStart      Int?
  rangeEnd        Int?
  protocolNumber  String?           @db.VarChar(20)
  statusCode      String?           @db.VarChar(10)
  statusReason    String?           @db.Text
  xml             String?           @db.LongText
  protocolXml     String?           @db.LongText
  createdByUserId String?
  registeredAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  document FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([companyId, type, createdAt])
  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Caixa
// ---------------------------------------------------------------------------

// Ponto de venda físico. Uma loja pode ter mais de um (balcão, delivery), e o
// fechamento é por turno de cada um — misturar os dois torna a conferência
// impossível.
model CashRegister {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions CashSession[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

// Turno de caixa: abre com um valor contado, fecha com outro.
//
// `expected*` é calculado no fechamento e congelado — recalcular depois daria
// número diferente se um pedido fosse alterado, e a conferência precisa ser
// uma foto do momento.
model CashSession {
  id             String            @id @default(cuid())
  companyId      String
  cashRegisterId String
  status         CashSessionStatus @default(ABERTO)
  openingAmount  Decimal           @db.Decimal(10, 2)
  countedAmount  Decimal?          @db.Decimal(10, 2)
  expectedCash   Decimal?          @db.Decimal(10, 2)
  expectedCard   Decimal?          @db.Decimal(10, 2)
  expectedPix    Decimal?          @db.Decimal(10, 2)
  // Contado menos esperado, em dinheiro. Negativo é falta.
  difference     Decimal?          @db.Decimal(10, 2)
  // Fotografia do fechamento: vendas por método, CMV, margem, cancelamentos e
  // movimentações. Guardado como documento porque é isso que ele é — o
  // resultado daquele turno, imutável, não uma consulta que se refaz.
  summary        Json?
  notes          String?           @db.Text
  openedByUserId String
  closedByUserId String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id])
  movements    CashMovement[]

  @@index([companyId, status, openedAt])
  @@index([cashRegisterId, status])
}

model CashMovement {
  id              String           @id @default(cuid())
  companyId       String
  cashSessionId   String
  type            CashMovementType
  amount          Decimal          @db.Decimal(10, 2)
  reason          String           @db.Text
  createdByUserId String
  createdAt       DateTime         @default(now())

  session CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId, createdAt])
  @@index([companyId, createdAt])
}

model FiscalCertificate {
  id                String                  @id @default(cuid())
  companyId         String
  fileName          String
  contentEncrypted  String                  @db.LongText
  passwordEncrypted String                  @db.Text
  subjectName       String
  issuerName        String
  serialNumber      String                  @db.VarChar(80)
  notBefore         DateTime
  notAfter          DateTime
  status            FiscalCertificateStatus @default(ATIVO)
  // Último aviso de expiração enviado, para não repetir a cada rodada.
  expiryAlertedAt   DateTime?
  uploadedByUserId  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status, notAfter])
}

model CompanySettings {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  openingHours          Json?
  paymentMethodsEnabled Json?
  aiEnabled             Boolean  @default(true)
  aiKnowledgeBase       String?  @db.Text
  whatsappNumber        String?
  plan                  String   @default("BASICO")
  maxUsers              Int?
  maxProducts           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model DeliveryArea {
  id           String   @id @default(cuid())
  companyId    String
  neighborhood String
  city         String
  deliveryFee  Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([city, neighborhood])
}

// ---------------------------------------------------------------------------
// Pessoas dentro da empresa
// ---------------------------------------------------------------------------

model EmployeeProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@index([companyId])
}

model CustomerProfile {
  id          String    @id @default(cuid())
  userId      String
  companyId   String
  totalOrders Int       @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String?
  reference    String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Permissões granulares (para FUNCIONARIO)
// ---------------------------------------------------------------------------

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  id                String   @id @default(cuid())
  employeeProfileId String
  permissionId      String
  createdAt         DateTime @default(now())

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, permissionId])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId])
}

model Product {
  id          String  @id @default(cuid())
  companyId   String
  categoryId  String
  name        String
  description String? @db.Text
  price       Decimal @db.Decimal(10, 2)
  // Custo de compra/produção. É opcional para não transformar lucro em uma
  // estimativa quando a empresa ainda não cadastrou o custo do item.
  costPrice   Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  // Tributação do item. Tudo opcional: nulo significa "usa o padrão da
  // empresa" (CompanyFiscalProfile.default*). O NCM é o que mais varia num
  // cardápio — refeição pronta, bebida e cerveja têm códigos diferentes.
  ncm        String?    @db.VarChar(8)
  cest       String?    @db.VarChar(7)
  cfop       String?    @db.VarChar(4)
  taxOrigin  TaxOrigin?
  icmsCode   String?    @db.VarChar(3)
  icmsRate   Decimal?   @db.Decimal(5, 2)
  icmsReductionRate Decimal? @db.Decimal(5, 2)
  pisCode    String?    @db.VarChar(2)
  pisRate    Decimal?   @db.Decimal(5, 2)
  cofinsCode String?    @db.VarChar(2)
  cofinsRate Decimal?   @db.Decimal(5, 2)
  unit       String?    @db.VarChar(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category           @relation(fields: [categoryId], references: [id])
  variations       ProductVariation[]
  addons           ProductAddon[]
  orderItems       OrderItem[]
  diningOrderItems DiningOrderItem[]

  @@index([companyId])
  @@index([categoryId])
}

model ProductVariation {
  id         String  @id @default(cuid())
  productId  String
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isActive   Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAddon {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Decimal @default(0) @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Prévia efêmera de uma importação de cardápio. Guardamos apenas os itens já
// normalizados e os avisos — não o arquivo cru enviado pelo cliente. Isso
// reduz retenção de dados e impede que um preview antigo seja aplicado duas
// vezes ou por outra pessoa.
model CatalogImportSession {
  id                 String              @id @default(cuid())
  companyId          String
  createdByUserId    String
  sourceFileName     String
  sourceSummary      Json?
  normalizedProducts Json
  warnings           Json?
  aiRequestId        String?
  status             CatalogImportStatus @default(PENDENTE)
  expiresAt          DateTime
  appliedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, status, expiresAt])
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Order {
  id                     String      @id @default(cuid())
  companyId              String
  // Pedidos pelo site sempre têm conta. Pedidos do WhatsApp não exigem login,
  // então guardam nome/telefone no próprio documento sem criar credenciais
  // artificiais para o consumidor.
  customerId             String?
  customerName           String?
  customerPhone          String?     @db.VarChar(20)
  source                 OrderSource @default(SITE)
  whatsappConversationId String?
  whatsappOrderDraftId   String?     @unique

  addressId            String?
  deliveryStreet       String
  deliveryNumber       String
  deliveryComplement   String?
  deliveryNeighborhood String
  deliveryCity         String
  deliveryState        String
  deliveryReference    String?

  subtotal                     Decimal  @db.Decimal(10, 2)
  deliveryFee                  Decimal  @db.Decimal(10, 2)
  deliveryDistanceKm           Decimal? @db.Decimal(8, 2)
  deliveryRouteDurationMinutes Int?
  discount                     Decimal  @default(0) @db.Decimal(10, 2)
  total                        Decimal  @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDENTE)
  status        OrderStatus   @default(RECEBIDO)
  notes         String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id])
  // `Restrict` é o que o banco faz desde a criação da tabela: apagar um
  // usuário com pedidos falha, em vez de soltar o histórico do dono. Sem
  // declarar, o Prisma assumiria SET NULL — padrão de relação opcional — e a
  // próxima migration gerada mudaria a regra sem ninguém decidir.
  customer             User?                 @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  address              Address?              @relation(fields: [addressId], references: [id])
  // FKs compostas: mesmo uma escrita externa não consegue ligar um pedido à
  // conversa ou ao rascunho de outra empresa.
  whatsappConversation WhatsAppConversation? @relation("WhatsAppConversationOrders", fields: [whatsappConversationId, companyId], references: [id, companyId], onDelete: Restrict)
  whatsappOrderDraft   WhatsAppOrderDraft?   @relation("WhatsAppOrderDraftOrder", fields: [whatsappOrderDraftId, companyId], references: [id, companyId], onDelete: Restrict)

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  delivery       Delivery?
  payment        Payment?
  fiscalDocuments FiscalDocument[]

  @@unique([whatsappOrderDraftId, companyId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([companyId, customerPhone])
  @@index([whatsappConversationId, companyId])
  // Os relatórios filtram por faixa de createdAt dentro da empresa; sem este
  // índice a consulta varria todos os pedidos da empresa para depois descartar.
  @@index([companyId, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  productName         String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(10, 2)
  variationName       String?
  variationPriceDelta Decimal  @default(0) @db.Decimal(10, 2)
  addons              Json?
  notes               String?
  totalPrice          Decimal  @db.Decimal(10, 2)
  // Custo unitário no instante da venda. Guardado, não consultado depois: o
  // custo do produto muda, e recalcular a margem de um pedido antigo pelo
  // preço de compra de hoje reescreveria o resultado de um mês já fechado.
  unitCost            Decimal? @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  status          OrderStatus
  changedByUserId String?
  createdAt       DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Salão, mesas e comandas locais
// ---------------------------------------------------------------------------

model RestaurantTable {
  id        String      @id @default(cuid())
  companyId String
  name      String
  seats     Int         @default(4)
  area      String?
  status    TableStatus @default(LIVRE)
  // Token opaco usado somente no QR público. Nunca expomos o id interno da
  // mesa na URL, e o token pode ser rotacionado pelo administrador.
  qrToken   String      @unique
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions TableSession[]

  @@unique([companyId, name])
  // Dá ao banco uma chave composta para garantir que uma comanda só consiga
  // referenciar uma mesa da mesma empresa.
  @@unique([id, companyId])
  @@index([companyId, status])
}

model TableSession {
  id               String             @id @default(cuid())
  companyId        String
  tableId          String
  status           TableSessionStatus @default(ABERTA)
  customerName     String?
  customerPhone    String?
  // Preenchidos no fechamento pela equipe e usados pela NFC-e da própria
  // comanda. A emissão nunca supõe uma forma de pagamento.
  customerDocument String?            @db.VarChar(14)
  paymentMethod    PaymentMethod?
  paidAt           DateTime?
  guestCount       Int                @default(1)
  notes            String?            @db.Text
  // Quando a própria pessoa abre a mesa pelo QR não há um usuário interno
  // responsável ainda. O atendente é assumido depois por alguém da equipe.
  openedByUserId   String?
  attendantUserId  String?
  closedByUserId   String?
  openedFromQr     Boolean            @default(false)
  openedAt         DateTime           @default(now())
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A empresa faz parte da FK: uma sessão nunca pode ser ligada a uma mesa de
  // outra empresa, mesmo em uma escrita acidental fora do service.
  table          RestaurantTable @relation(fields: [tableId, companyId], references: [id, companyId], onDelete: Restrict)
  // Mantém a regra histórica da auditoria: não remove um usuário que abriu
  // uma comanda sem antes tratar o vínculo explicitamente.
  openedBy       User?           @relation("TableSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  attendant      User?           @relation("TableSessionAttendant", fields: [attendantUserId], references: [id])
  closedBy       User?           @relation("TableSessionClosedBy", fields: [closedByUserId], references: [id])
  orders         DiningOrder[]
  fiscalDocuments FiscalDocument[] @relation("FiscalDocumentTableSession")

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([tableId, status])
  @@index([tableId, companyId])
  @@index([companyId, attendantUserId, status])
}

model DiningOrder {
  id              String            @id @default(cuid())
  companyId       String
  tableSessionId  String
  createdByUserId String?
  source          DiningOrderSource @default(EQUIPE)
  status          DiningOrderStatus @default(RECEBIDO)
  subtotal        Decimal           @db.Decimal(10, 2)
  notes           String?           @db.Text
  servedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // A rodada compartilha a mesma empresa da comanda por uma FK composta. Isso
  // impede que um pedido seja gravado na sessão de outra operação.
  session   TableSession      @relation(fields: [tableSessionId, companyId], references: [id, companyId], onDelete: Cascade)
  createdBy User?             @relation("DiningOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     DiningOrderItem[]

  @@index([companyId, status])
  @@index([tableSessionId])
  @@index([tableSessionId, companyId])
  @@index([companyId, source])
}

model DiningOrderItem {
  id            String  @id @default(cuid())
  diningOrderId String
  productId     String
  productName   String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  notes         String?
  totalPrice    Decimal @db.Decimal(10, 2)

  order   DiningOrder @relation(fields: [diningOrderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([diningOrderId])
}

// ---------------------------------------------------------------------------
// Entregas e pagamentos
// ---------------------------------------------------------------------------

model Delivery {
  id                       String                 @id @default(cuid())
  orderId                  String                 @unique
  companyId                String
  motoboyId                String?
  status                   DeliveryStatus         @default(AGUARDANDO_RETIRADA)
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  notes                    String?                @db.Text
  problemReason            DeliveryProblemReason?
  problemDescription       String?                @db.Text
  statusBeforeProblem      DeliveryStatus?
  problemReportedAt        DateTime?
  problemResolvedAt        DateTime?
  motoboyLatitude          Float?
  motoboyLongitude         Float?
  motoboyLocationUpdatedAt DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id])
  motoboy   User?              @relation("DeliveryMotoboy", fields: [motoboyId], references: [id])
  incidents DeliveryIncident[]

  @@index([companyId, status])
  @@index([motoboyId])
  @@index([companyId, createdAt])
}

model DeliveryIncident {
  id               String                @id @default(cuid())
  deliveryId       String
  previousStatus   DeliveryStatus
  reason           DeliveryProblemReason
  description      String?               @db.Text
  reportedByUserId String
  reportedAt       DateTime              @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, reportedAt])
  @@index([reportedByUserId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  companyId String
  method    PaymentMethod
  status    PaymentStatus @default(PENDENTE)
  amount    Decimal       @db.Decimal(10, 2)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Promotion {
  id            String          @id @default(cuid())
  companyId     String
  title         String
  description   String?         @db.Text
  discountType  String
  discountValue Decimal         @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  status        PromotionStatus @default(RASCUNHO)
  createdByAI   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Revendedores, planos, assinaturas e aquisição comercial
// ---------------------------------------------------------------------------

model ResellerApplication {
  id                          String            @id @default(cuid())
  fullName                    String
  email                       String
  phone                       String
  document                    String
  city                        String
  state                       String
  linkedinUrl                 String?
  resumeUrl                   String?
  resumeText                  String?           @db.Text
  motivation                  String            @db.Text
  commitment                  String            @db.Text
  experience                  String?           @db.Text
  passwordHash                String
  termsAcceptedAt             DateTime?
  privacyAcceptedAt           DateTime?
  automatedAnalysisAcceptedAt DateTime?
  status                      ApplicationStatus @default(EM_ANALISE_IA)
  attemptCount                Int               @default(1)
  aiScore                     Int?
  aiDecision                  String?
  aiFeedback                  String?           @db.Text
  aiAnalysis                  Json?
  reviewNotes                 String?           @db.Text
  reviewedByUserId            String?
  reviewedAt                  DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  reviewedBy User?            @relation("ResellerApplicationReviewedBy", fields: [reviewedByUserId], references: [id])
  reseller   ResellerProfile?

  @@index([email])
  @@index([status, createdAt])
}

model ResellerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  applicationId        String?  @unique
  code                 String   @unique
  commissionRate       Decimal  @default(0.30) @db.Decimal(5, 4)
  stripeAccountId      String?  @unique
  stripeOnboardingOk   Boolean  @default(false)
  // Subconta Asaas do revendedor. O walletId endereça as transferências; a
  // chave de API é devolvida uma única vez na criação, então é guardada cifrada
  // — sem ela não há como consultar o saldo da subconta depois.
  asaasWalletId        String?  @unique
  asaasAccountId       String?  @unique
  asaasApiKeyEncrypted String?  @db.Text
  asaasOnboardingOk    Boolean  @default(false)
  isActive             Boolean  @default(true)
  approvedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  application               ResellerApplication?       @relation(fields: [applicationId], references: [id])
  subscriptions             ClientSubscription[]
  commissions               CommissionLedger[]
  prospects                 ResellerProspect[]
  leads                     SalesLead[]
  clientApplications        ClientApplication[]
  payoutBatches             PayoutBatch[]
  superAdminSupportAccesses SuperAdminResellerAccess[]
}

model SoftwarePlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  monthlyPrice  Decimal  @db.Decimal(10, 2)
  currency      String   @default("brl")
  stripePriceId String?  @unique
  // O Asaas não tem catálogo de preços: o valor vai na criação da assinatura.
  features      Json
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions      ClientSubscription[]
  clientApplications ClientApplication[]
}

model ClientApplication {
  id                          String            @id @default(cuid())
  companyId                   String?           @unique
  planId                      String
  resellerId                  String?
  resellerCode                String?
  responsibleName             String
  email                       String
  phone                       String
  document                    String
  companyName                 String
  tradeName                   String?
  city                        String
  state                       String
  businessType                String
  operationDetails            String            @db.Text
  passwordHash                String
  termsAcceptedAt             DateTime?
  privacyAcceptedAt           DateTime?
  automatedAnalysisAcceptedAt DateTime?
  // Mantém a origem da candidatura caso o provisionamento ocorra depois (por
  // revisão humana ou webhook legado), quando o request/IP original já não
  // existe mais.
  isTestOnly                  Boolean           @default(false)
  // Preserva o valor de homologação mesmo se a aprovação acontecer depois
  // de o modo temporário ser desligado.
  monthlyPriceSnapshot        Decimal?          @db.Decimal(10, 2)
  status                      ApplicationStatus @default(EM_ANALISE_IA)
  aiScore                     Int?
  aiFeedback                  String?           @db.Text
  aiAnalysis                  Json?
  stripeSessionId             String?           @unique
  asaasPaymentId              String?           @unique
  sourceLeadId                String?           @unique
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  company    Company?         @relation(fields: [companyId], references: [id])
  plan       SoftwarePlan     @relation(fields: [planId], references: [id])
  reseller   ResellerProfile? @relation(fields: [resellerId], references: [id])
  sourceLead SalesLead?       @relation(fields: [sourceLeadId], references: [id])

  @@index([email])
  @@index([status])
}

model ClientSubscription {
  id                      String             @id @default(cuid())
  companyId               String             @unique
  planId                  String
  // Congela o preço escolhido na entrada do teste. Assim um preço temporário
  // de homologação não muda quando a configuração volta ao valor comercial.
  monthlyPriceSnapshot    Decimal?           @db.Decimal(10, 2)
  resellerId              String?
  status                  SubscriptionStatus @default(PENDENTE)
  trialStartedAt          DateTime?
  trialEndsAt             DateTime?
  stripeCustomerId        String?            @unique
  stripeSubscriptionId    String?            @unique
  stripeCheckoutSessionId String?            @unique
  asaasCustomerId         String?            @unique
  asaasSubscriptionId     String?            @unique
  // Cobrança de ativação em aberto. Guardada para reaproveitar o link em vez de
  // gerar uma segunda cobrança a cada clique.
  asaasPaymentId          String?            @unique
  referralCode            String?
  referralLockedAt        DateTime?
  discountEndsAt          DateTime?
  // Quando a assinatura no provedor voltou ao preço cheio depois da janela de
  // desconto por indicação. Sem esse marco a varredura não teria como saber se
  // já ajustou, e reenviaria a mesma atualização todo dia.
  discountRemovedAt       DateTime?
  // Limites explícitos do ciclo já pago. O início impede que o painel use mês
  // civil e reapresente consumo da fatura anterior depois da baixa.
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  // Identifica a cobrança Asaas que concedeu o período atual. Além de tornar
  // PAYMENT_CONFIRMED/RECEIVED idempotentes, evita que um estorno antigo corte
  // o acesso de uma renovação posterior.
  asaasPeriodPaymentId    String?
  canceledAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        SoftwarePlan       @relation(fields: [planId], references: [id])
  reseller    ResellerProfile?   @relation(fields: [resellerId], references: [id])
  commissions CommissionLedger[]

  @@index([resellerId, status])
  @@index([status, trialEndsAt])
}

model CommissionLedger {
  id                     String           @id @default(cuid())
  resellerId             String
  subscriptionId         String
  stripeInvoiceId        String?          @unique
  asaasPaymentId         String?          @unique
  // Referência interna para ajustes financeiros. Diferente dos IDs dos
  // provedores, ela permite registrar uma recuperação de estorno sem fingir
  // que o ajuste é uma nova cobrança Asaas/Stripe.
  externalReference      String?          @unique
  grossAmount            Decimal          @db.Decimal(10, 2)
  commissionRate         Decimal          @db.Decimal(5, 4)
  commissionAmount       Decimal          @db.Decimal(10, 2)
  currency               String           @default("brl")
  status                 CommissionStatus @default(DISPONIVEL)
  // `settledAt` só é preenchido quando o dinheiro entrou no saldo da conta
  // raiz. `PAYMENT_CONFIRMED` libera o produto, mas ainda não autoriza saque.
  settledAt              DateTime?
  availableAt            DateTime?
  // A tela diferencia compensação, reserva e contestação sem expor jargão do
  // provedor. O motivo não altera o histórico financeiro, apenas explica por
  // que uma comissão ainda não está disponível.
  holdReason             String?          @db.VarChar(191)
  availabilityNotifiedAt DateTime?
  paidAt                 DateTime?
  stripeTransferId       String?
  asaasTransferId        String?
  payoutBatchId          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  reseller     ResellerProfile    @relation(fields: [resellerId], references: [id])
  subscription ClientSubscription @relation(fields: [subscriptionId], references: [id])
  payoutBatch  PayoutBatch?       @relation(fields: [payoutBatchId], references: [id])

  @@index([resellerId, status])
  @@index([status, settledAt])
  @@index([stripeTransferId])
  @@index([payoutBatchId])
}

model PayoutBatch {
  id               String            @id @default(cuid())
  resellerId       String
  status           PayoutBatchStatus @default(PROCESSANDO)
  amount           Decimal           @db.Decimal(10, 2)
  currency         String            @default("brl")
  stripeTransferId String?           @unique
  asaasTransferId  String?           @unique
  failureReason    String?           @db.Text
  attempts         Int               @default(0)
  nextAttemptAt    DateTime?
  // Mesmo papel do campo homônimo em StripeEvent: garante um único aviso por
  // lote encerrado por esgotamento de tentativas.
  alertedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  completedAt      DateTime?

  reseller    ResellerProfile    @relation(fields: [resellerId], references: [id])
  commissions CommissionLedger[]

  @@index([resellerId, status, createdAt])
  @@index([status, nextAttemptAt])
}

/// Fila de webhooks de cobrança. Nasceu para o Stripe e passou a atender também
/// o Asaas: o retry, o alerta de esgotamento e a tela de saúde operacional são
/// os mesmos, e duplicá-los daria dois lugares para corrigir o mesmo problema.
/// O nome do modelo permanece por ora para não renomear a tabela em produção.
model StripeEvent {
  id          String            @id
  provider    BillingProvider   @default(STRIPE)
  type        String
  payload     Json
  status      StripeEventStatus @default(PENDENTE)
  attempts    Int               @default(0)
  lastError   String?           @db.Text
  processedAt DateTime?
  // Marca que a operação já foi avisada de que este evento esgotou as
  // tentativas. Sem isso o alerta se repetiria a cada rodada do worker.
  alertedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([status, alertedAt])
}

model ResellerProspect {
  id            String    @id @default(cuid())
  resellerId    String
  name          String
  companyName   String?
  email         String?
  phone         String?
  stage         String    @default("NOVO")
  notes         String?   @db.Text
  nextContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reseller ResellerProfile @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([resellerId, stage])
}

model SalesLead {
  id              String     @id @default(cuid())
  name            String
  companyName     String?
  email           String
  phone           String
  city            String?
  state           String?
  message         String     @db.Text
  status          LeadStatus @default(DISPONIVEL)
  resellerId      String?
  claimedByUserId String?
  claimedAt       DateTime?
  convertedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  reseller          ResellerProfile?   @relation(fields: [resellerId], references: [id])
  claimedBy         User?              @relation("SalesLeadClaimedBy", fields: [claimedByUserId], references: [id])
  clientApplication ClientApplication?

  @@index([status, createdAt])
  @@index([resellerId, status])
}

// ---------------------------------------------------------------------------
// Agente de IA
// ---------------------------------------------------------------------------

model AIConversation {
  id        String      @id @default(cuid())
  companyId String
  agentRole AIAgentRole
  channel   AIChannel
  userId    String?
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("AIConversationUser", fields: [userId], references: [id])

  messages             AIMessage[]
  actionLogs           AIActionLog[]
  whatsappConversation WhatsAppConversation?

  @@index([companyId, channel])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  toolName       String?
  toolPayload    Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIActionLog {
  id                   String    @id @default(cuid())
  conversationId       String
  companyId            String
  toolName             String
  payload              Json
  requiresConfirmation Boolean   @default(true)
  confirmed            Boolean   @default(false)
  confirmedByUserId    String?
  confirmedAt          DateTime?
  result               Json?
  createdAt            DateTime  @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  confirmedBy  User?          @relation("AIActionConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Mensageria (WhatsApp fase 1/2)
// ---------------------------------------------------------------------------

model MessagingChannel {
  id                       String                 @id @default(cuid())
  companyId                String
  type                     MessagingChannelType   @default(WHATSAPP)
  status                   MessagingChannelStatus @default(ATIVO)
  provider                 WhatsAppProvider       @default(GUPSHUP)
  config                   Json
  // Credenciais Gupshup. O app token vale 24h e é renovado sob demanda; guardá-lo
  // cifrado evita ida à Partner API a cada mensagem sem expor a credencial.
  gupshupAppId             String?                @unique
  // O callback v2 do self-serve identifica o app pelo nome, então ele também
  // precisa ser único para resolver o canal sem ambiguidade.
  gupshupAppName           String?                @unique
  gupshupAppTokenEncrypted String?                @db.Text
  gupshupAppTokenExpiresAt DateTime?
  // Momento em que o empresário pediu o WhatsApp. No self-serve o aplicativo é
  // criado à mão pelo superadmin, então é este campo que sinaliza que há
  // trabalho esperando por ele.
  accessRequestedAt        DateTime?
  automationEnabled        Boolean                @default(true)
  welcomeMessage           String?                @db.Text
  connectedAt              DateTime?
  lastWebhookAt            DateTime?
  lastError                String?                @db.Text
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  usageLedgers  UsageLedger[]

  @@unique([companyId, type])
}

// ---------------------------------------------------------------------------
// Central de atendimento WhatsApp Cloud API e consumo variável
// ---------------------------------------------------------------------------

model WhatsAppConversation {
  id               String                     @id @default(cuid())
  companyId        String
  channelId        String
  aiConversationId String?                    @unique
  customerPhone    String
  customerName     String?
  mode             WhatsAppConversationMode   @default(VIRTUAL)
  status           WhatsAppConversationStatus @default(ABERTA)
  assignedToUserId String?
  lastMessageText  String?                    @db.Text
  lastMessageAt    DateTime                   @default(now())
  lastInboundAt    DateTime?
  humanRequestedAt DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel        MessagingChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  aiConversation AIConversation?      @relation(fields: [aiConversationId], references: [id], onDelete: SetNull)
  assignedTo     User?                @relation("WhatsAppConversationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages       WhatsAppMessage[]
  orderDrafts    WhatsAppOrderDraft[]
  orders         Order[]              @relation("WhatsAppConversationOrders")

  @@unique([channelId, customerPhone])
  // Serve de destino para FKs compostas que materializam o isolamento de
  // pedidos pelo WhatsApp no banco.
  @@unique([id, companyId])
  @@index([companyId, status, lastMessageAt])
  @@index([assignedToUserId])
}

model WhatsAppOrderDraft {
  id                      String                   @id @default(cuid())
  companyId               String
  conversationId          String
  // Chave única só enquanto o carrinho está aberto. Ao concluir/cancelar ela
  // vira nula, preservando o histórico e permitindo o próximo pedido do mesmo
  // número sem reutilizar o rascunho que já gerou uma venda.
  activeKey               String?                  @unique
  status                  WhatsAppOrderDraftStatus @default(MONTANDO)
  // Linhas escolhidas pelo cliente (IDs e quantidades), nunca preços vindos
  // do modelo. Os preços são sempre re-resolvidos no servidor antes de criar.
  cart                    Json?
  customerName            String?
  addressStreet           String?
  addressNumber           String?
  addressComplement       String?
  addressNeighborhood     String?
  addressCity             String?
  addressState            String?                  @db.VarChar(2)
  addressZipCode          String?                  @db.VarChar(8)
  addressReference        String?
  addressLatitude         Decimal?                 @db.Decimal(10, 7)
  addressLongitude        Decimal?                 @db.Decimal(10, 7)
  paymentMethod           PaymentMethod?
  notes                   String?                  @db.Text
  // Foto calculada pelo servidor (itens, rota, frete e total) apresentada ao
  // cliente antes de ele confirmar. O hash impede confirmar valor alterado.
  quoteSnapshot           Json?
  quoteFingerprint        String?                  @db.VarChar(64)
  confirmationRequestedAt DateTime?
  confirmedAt             DateTime?
  completedAt             DateTime?
  lastError               String?                  @db.Text
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: Cascade)
  order        Order?               @relation("WhatsAppOrderDraftOrder")

  @@unique([id, companyId])
  @@index([companyId, status, updatedAt])
  @@index([conversationId, companyId, status, updatedAt])
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  companyId         String
  channelId         String
  conversationId    String
  providerMessageId String?                  @unique
  direction         WhatsAppMessageDirection
  status            WhatsAppMessageStatus
  type              String                   @default("text")
  body              String?                  @db.Text
  pricingCategory   String?
  providerCost      Decimal                  @default(0) @db.Decimal(16, 6)
  billableAmount    Decimal                  @default(0) @db.Decimal(16, 6)
  sentByUserId      String?
  errorCode         String?
  errorMessage      String?                  @db.Text
  rawPayload        Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel      MessagingChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?                @relation("WhatsAppMessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([conversationId, createdAt])
  @@index([channelId, providerMessageId])
}

// ---------------------------------------------------------------------------
// WhatsApp institucional da ChegowIA
// ---------------------------------------------------------------------------
//
// Este canal não pertence a uma Company. Ele atende somente a operação
// institucional da plataforma (vendas, dúvidas e suporte pré-comercial) e usa
// tabelas independentes justamente para não permitir que uma conversa do
// superadmin atravesse o isolamento dos tenants.

model PlatformWhatsAppChannel {
  id                       String                 @id @default(cuid())
  key                      String                 @unique
  status                   MessagingChannelStatus @default(ATIVO)
  provider                 WhatsAppProvider       @default(GUPSHUP)
  config                   Json
  gupshupAppId             String?                @unique
  // Único como no canal das empresas: o callback v2 do self-serve identifica o
  // aplicativo pelo nome, e é por ele que este canal é resolvido.
  gupshupAppName           String?                @unique
  gupshupAppTokenEncrypted String?                @db.Text
  gupshupAppTokenExpiresAt DateTime?
  automationEnabled        Boolean                @default(true)
  welcomeMessage           String?                @db.Text
  salesInstructions        String?                @db.Text
  // Modelo aprovado na Meta usado para abrir conversa com quem nunca escreveu.
  // Fora da janela de 24h a API oficial recusa texto livre, então sem isto a
  // prospecção não tem como começar — e é melhor a tela dizer isso do que o
  // provedor recusar número por número.
  outreachTemplateId       String?
  outreachTemplateName     String?
  outreachTemplateLanguage String?
  outreachTemplateBody     String?                @db.Text
  // Quais campos do contato preenchem {{1}}, {{2}}… na ordem do modelo.
  outreachTemplateParams   Json?
  connectedAt              DateTime?
  lastWebhookAt            DateTime?
  lastError                String?                @db.Text
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  conversations PlatformWhatsAppConversation[]
  messages      PlatformWhatsAppMessage[]
  usageLedgers  PlatformUsageLedger[]
  campaigns     PlatformOutreachCampaign[]
}

model PlatformWhatsAppConversation {
  id               String                     @id @default(cuid())
  channelId        String
  customerPhone    String
  customerName     String?
  mode             WhatsAppConversationMode   @default(VIRTUAL)
  status           WhatsAppConversationStatus @default(ABERTA)
  lastMessageText  String?                    @db.Text
  lastMessageAt    DateTime                   @default(now())
  lastInboundAt    DateTime?
  humanRequestedAt DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  channel  PlatformWhatsAppChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages PlatformWhatsAppMessage[]
  targets  PlatformOutreachTarget[]

  @@unique([channelId, customerPhone])
  @@index([status, lastMessageAt])
}

model PlatformWhatsAppMessage {
  id                String                   @id @default(cuid())
  channelId         String
  conversationId    String
  providerMessageId String?                  @unique
  direction         WhatsAppMessageDirection
  status            WhatsAppMessageStatus
  type              String                   @default("text")
  body              String?                  @db.Text
  sentByUserId      String?
  sentByName        String?
  errorCode         String?
  errorMessage      String?                  @db.Text
  rawPayload        Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  channel      PlatformWhatsAppChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation PlatformWhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([channelId, providerMessageId])
}

// ---------------------------------------------------------------------------
// Suporte autenticado da ChegowIA
// ---------------------------------------------------------------------------
//
// O usuário e a empresa ficam fotografados no momento da abertura. Assim a
// central mostra contexto útil ao superadmin, mas nunca confia em ids enviados
// pelo navegador nem precisa consultar ou expor dados de outro tenant.

model PlatformSupportConversation {
  id                     String                            @id @default(cuid())
  userId                 String
  // Enquanto o atendimento está aberto, activeKey recebe o userId e garante
  // uma única conversa ativa por pessoa. Ao encerrar, ela vira null, permitindo
  // que o mesmo usuário abra um novo atendimento posteriormente.
  activeKey              String?                           @unique
  userName               String
  userEmail              String
  userRole               Role
  companyIdSnapshot      String?
  companyNameSnapshot    String?
  mode                   PlatformSupportConversationMode   @default(IA)
  status                 PlatformSupportConversationStatus @default(ABERTA)
  lastMessageText        String?                           @db.Text
  lastMessageAt          DateTime                          @default(now())
  humanRequestedAt       DateTime?
  humanHandoffNotifiedAt DateTime?
  assignedSuperAdminId   String?
  closedAt               DateTime?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  user               User                     @relation("PlatformSupportUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedSuperAdmin User?                    @relation("PlatformSupportAssignedSuperAdmin", fields: [assignedSuperAdminId], references: [id], onDelete: SetNull)
  messages           PlatformSupportMessage[]
  usageLedgers       PlatformUsageLedger[]

  @@index([userId, lastMessageAt])
  @@index([status, mode, lastMessageAt])
  @@index([assignedSuperAdminId, status, lastMessageAt], map: "PlatformSupportConversation_assigned_status_last_at_idx")
}

model PlatformSupportMessage {
  id             String                     @id @default(cuid())
  conversationId String
  authorUserId   String?
  role           PlatformSupportMessageRole
  content        String                     @db.Text
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  conversation PlatformSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?                       @relation("PlatformSupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// Consumo pago pela própria ChegowIA no seu canal comercial. Não é uma fatura
// de cliente e, por isso, não reutiliza UsageLedger (que obrigatoriamente tem
// companyId). Guardamos a tarifa calculada no instante do uso para auditoria.
model PlatformUsageLedger {
  id                    String      @id @default(cuid())
  // O custo institucional pode nascer no WhatsApp comercial ou no suporte
  // autenticado. Cada linha referencia exatamente um deles.
  channelId             String?
  supportConversationId String?
  usageRateId           String?
  source                UsageSource
  metric                UsageMetric
  quantity              Decimal     @db.Decimal(18, 6)
  providerAmount        Decimal     @default(0) @db.Decimal(16, 6)
  currency              String      @default("brl")
  externalReference     String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  channel             PlatformWhatsAppChannel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  supportConversation PlatformSupportConversation? @relation(fields: [supportConversationId], references: [id], onDelete: Cascade)
  usageRate           UsageRate?                   @relation(fields: [usageRateId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@index([supportConversationId, createdAt])
  @@index([source, metric, createdAt])
}

model UsageRate {
  id               String      @id @default(cuid())
  metric           UsageMetric @unique
  provider         String
  label            String
  unitSize         Decimal     @default(1) @db.Decimal(16, 6)
  providerUnitCost Decimal     @default(0) @db.Decimal(16, 6)
  markupPercent    Decimal     @default(0) @db.Decimal(8, 4)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  usageLedgers         UsageLedger[]
  platformUsageLedgers PlatformUsageLedger[]
}

model UsageLedger {
  id                  String            @id @default(cuid())
  companyId           String
  channelId           String?
  usageRateId         String?
  source              UsageSource
  metric              UsageMetric
  quantity            Decimal           @db.Decimal(18, 6)
  providerAmount      Decimal           @default(0) @db.Decimal(16, 6)
  billableAmount      Decimal           @default(0) @db.Decimal(16, 6)
  currency            String            @default("brl")
  externalReference   String?           @unique
  // Consumo ocorrido durante o teste gratuito. Ele mantém custo e tarifa
  // auditáveis, mas nunca é enviado como item de fatura ao cliente.
  trialCoveredAt      DateTime?
  status              UsageLedgerStatus @default(PENDENTE)
  stripeInvoiceItemId String?
  stripeInvoiceId     String?
  // No Asaas o consumo é somado ao valor da cobrança seguinte; guardamos qual
  // cobrança absorveu cada lançamento para não faturar duas vezes.
  asaasPaymentId      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   MessagingChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  usageRate UsageRate?        @relation(fields: [usageRateId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, trialCoveredAt, status])
  @@index([stripeInvoiceItemId])
  @@index([stripeInvoiceId])
  // Não é único de propósito: uma cobrança do Asaas cobre várias linhas de uso.
  // O webhook procura por este campo para marcar o lote inteiro como pago, e o
  // índice existe no banco desde 20260813030000 — declarar aqui evita que a
  // próxima migration gerada o derrube e transforme aquela busca em varredura.
  @@index([asaasPaymentId])
}

// ---------------------------------------------------------------------------
// Prospecção ativa pelo WhatsApp institucional
// ---------------------------------------------------------------------------
//
// Um disparo é uma lista colada de uma vez. Ele guarda o próprio ritmo porque a
// qualidade do número é o ativo em jogo: se o mesmo número que atende o suporte
// levar denúncia de spam, a Meta restringe tudo junto. Daí limite diário,
// intervalo entre envios e pausa automática ficarem no registro, e não em
// constante no código — cada lista tem um risco diferente.
model PlatformOutreachCampaign {
  id        String                 @id @default(cuid())
  channelId String
  name      String
  status    OutreachCampaignStatus @default(RASCUNHO)

  // Como o contato é chamado quando a lista não trouxe nome. Modelo aprovado com
  // variável não aceita parâmetro vazio: a Meta recusa o envio inteiro.
  fallbackName String @default("tudo bem")

  dailyLimit           Int     @default(200)
  minIntervalSeconds   Int     @default(15)
  maxIntervalSeconds   Int     @default(30)
  // Disparo de madrugada é o caminho mais curto para ser denunciado. Continua
  // desligável para quem quiser testar fora do horário.
  respectBusinessHours Boolean @default(true)

  // Quando o próximo envio pode sair. É o que espaça as mensagens sem depender
  // de o processo continuar vivo entre uma e outra.
  nextSendAt   DateTime?
  pausedReason String?   @db.Text

  totalTargets Int @default(0)
  sentCount    Int @default(0)
  repliedCount Int @default(0)
  failedCount  Int @default(0)

  createdByUserId String?
  createdByName   String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  channel PlatformWhatsAppChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targets PlatformOutreachTarget[]

  @@index([status, nextSendAt])
}

model PlatformOutreachTarget {
  id         String               @id @default(cuid())
  campaignId String
  phone      String
  name       String?
  company    String?
  city       String?
  status     OutreachTargetStatus @default(PENDENTE)

  conversationId String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  repliedAt      DateTime?
  errorMessage   String?   @db.Text
  discardReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign     PlatformOutreachCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversation PlatformWhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // O mesmo número não recebe duas vezes o mesmo disparo, nem quando a lista
  // colada vem com repetição.
  @@unique([campaignId, phone])
  @@index([status, campaignId])
  @@index([phone])
}

// Quem pediu para não receber mais. Vale para todos os disparos e também para a
// conversa aberta à mão: um "me tira dessa lista" que só valesse para a
// campanha em curso seria contornado pela próxima lista colada.
model PlatformOutreachBlock {
  id            String   @id @default(cuid())
  phone         String   @unique
  reason        String?
  blockedByName String?
  createdAt     DateTime @default(now())
}
