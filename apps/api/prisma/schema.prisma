generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (manter em sincronia com packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  FUNCIONARIO
  COZINHA
  MOTOBOY
  CLIENTE
}

enum OrderStatus {
  RECEBIDO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA
  ENTREGUE
  CANCELADO
}

enum DeliveryStatus {
  AGUARDANDO_RETIRADA
  RETIRADO
  EM_ROTA
  ENTREGUE
  PROBLEMA
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_ENTREGA
  PIX_MANUAL
}

enum PaymentStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum PromotionStatus {
  RASCUNHO
  PENDENTE_CONFIRMACAO
  ATIVA
  ENCERRADA
}

enum AIAgentRole {
  OPERACIONAL
  ATENDIMENTO
  ONBOARDING
}

enum AIChannel {
  INTERNO
  CLIENTE
}

enum AIMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum MessagingChannelType {
  WHATSAPP
}

enum MessagingChannelStatus {
  ATIVO
  INATIVO
}

// ---------------------------------------------------------------------------
// Identidade / plataforma
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  isActive     Boolean  @default(true)
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  refreshTokens   RefreshToken[]
  employeeProfile EmployeeProfile?
  customerProfiles CustomerProfile[]
  addresses       Address[]

  ordersAsCustomer     Order[]            @relation("OrderCustomer")
  orderStatusChanges   OrderStatusHistory[] @relation("OrderStatusChangedBy")
  deliveriesAsMotoboy  Delivery[]         @relation("DeliveryMotoboy")
  aiConversations      AIConversation[]   @relation("AIConversationUser")
  aiActionsConfirmed   AIActionLog[]      @relation("AIActionConfirmedBy")

  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Empresa (tenant)
// ---------------------------------------------------------------------------

model Company {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  cnpj                    String?
  phone                   String?
  whatsapp                String?
  addressLine             String?
  city                    String?
  state                   String?
  deliveryFeeBase         Decimal  @default(0) @db.Decimal(10, 2)
  avgDeliveryTimeMinutes  Int      @default(40)
  logoUrl                 String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  settings          CompanySettings?
  users             User[]
  deliveryAreas     DeliveryArea[]
  categories        Category[]
  products          Product[]
  orders            Order[]
  deliveries        Delivery[]
  payments          Payment[]
  employeeProfiles  EmployeeProfile[]
  customerProfiles  CustomerProfile[]
  promotions        Promotion[]
  messagingChannels MessagingChannel[]
  aiConversations   AIConversation[]
  aiActionLogs      AIActionLog[]

  @@index([city, state])
}

model CompanySettings {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  openingHours          Json?
  paymentMethodsEnabled Json?
  aiEnabled             Boolean  @default(true)
  aiKnowledgeBase       String?  @db.Text
  whatsappNumber        String?
  plan                  String   @default("BASICO")
  maxUsers              Int?
  maxProducts           Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model DeliveryArea {
  id           String   @id @default(cuid())
  companyId    String
  neighborhood String
  city         String
  deliveryFee  Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([city, neighborhood])
}

// ---------------------------------------------------------------------------
// Pessoas dentro da empresa
// ---------------------------------------------------------------------------

model EmployeeProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@index([companyId])
}

model CustomerProfile {
  id          String    @id @default(cuid())
  userId      String
  companyId   String
  totalOrders Int       @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String?
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Permissões granulares (para FUNCIONARIO)
// ---------------------------------------------------------------------------

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  id                String   @id @default(cuid())
  employeeProfileId String
  permissionId      String
  createdAt         DateTime @default(now())

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, permissionId])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category           @relation(fields: [categoryId], references: [id])
  variations ProductVariation[]
  addons     ProductAddon[]
  orderItems OrderItem[]

  @@index([companyId])
  @@index([categoryId])
}

model ProductVariation {
  id         String  @id @default(cuid())
  productId  String
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isActive   Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAddon {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Decimal @default(0) @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Pedidos
// ---------------------------------------------------------------------------

model Order {
  id         String  @id @default(cuid())
  companyId  String
  customerId String

  addressId        String?
  deliveryStreet       String
  deliveryNumber       String
  deliveryComplement   String?
  deliveryNeighborhood String
  deliveryCity         String
  deliveryState        String
  deliveryReference    String?

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDENTE)
  status        OrderStatus   @default(RECEBIDO)
  notes         String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id])
  customer User    @relation("OrderCustomer", fields: [customerId], references: [id])
  address  Address? @relation(fields: [addressId], references: [id])

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  delivery      Delivery?
  payment       Payment?

  @@index([companyId, status])
  @@index([customerId])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String
  productName          String
  quantity             Int
  unitPrice            Decimal @db.Decimal(10, 2)
  variationName        String?
  variationPriceDelta  Decimal @default(0) @db.Decimal(10, 2)
  addons               Json?
  notes                String?
  totalPrice           Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id            String      @id @default(cuid())
  orderId       String
  status        OrderStatus
  changedByUserId String?
  createdAt     DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Entregas e pagamentos
// ---------------------------------------------------------------------------

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  companyId   String
  motoboyId   String?
  status      DeliveryStatus @default(AGUARDANDO_RETIRADA)
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  notes       String?        @db.Text
  motoboyLatitude          Float?
  motoboyLongitude         Float?
  motoboyLocationUpdatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  motoboy User?   @relation("DeliveryMotoboy", fields: [motoboyId], references: [id])

  @@index([companyId, status])
  @@index([motoboyId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  companyId String
  method    PaymentMethod
  status    PaymentStatus @default(PENDENTE)
  amount    Decimal       @db.Decimal(10, 2)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Promotion {
  id            String          @id @default(cuid())
  companyId     String
  title         String
  description   String?         @db.Text
  discountType  String
  discountValue Decimal         @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  status        PromotionStatus @default(RASCUNHO)
  createdByAI   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Agente de IA
// ---------------------------------------------------------------------------

model AIConversation {
  id        String      @id @default(cuid())
  companyId String
  agentRole AIAgentRole
  channel   AIChannel
  userId    String?
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("AIConversationUser", fields: [userId], references: [id])

  messages    AIMessage[]
  actionLogs  AIActionLog[]

  @@index([companyId, channel])
}

model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  toolName       String?
  toolPayload    Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIActionLog {
  id                   String    @id @default(cuid())
  conversationId       String
  companyId            String
  toolName             String
  payload              Json
  requiresConfirmation Boolean   @default(true)
  confirmed            Boolean   @default(false)
  confirmedByUserId    String?
  confirmedAt          DateTime?
  result               Json?
  createdAt            DateTime  @default(now())

  conversation  AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  confirmedBy   User?          @relation("AIActionConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Mensageria (WhatsApp fase 1/2)
// ---------------------------------------------------------------------------

model MessagingChannel {
  id        String                 @id @default(cuid())
  companyId String
  type      MessagingChannelType   @default(WHATSAPP)
  status    MessagingChannelStatus @default(ATIVO)
  config    Json
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
}
