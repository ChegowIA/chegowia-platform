# ---- MySQL / Docker ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=chegowia
MYSQL_USER=chegowia
MYSQL_PASSWORD=chegowia
MYSQL_PORT=3306
ADMINER_PORT=8090

# ---- apps/api ----
DATABASE_URL="mysql://chegowia:chegowia@localhost:3306/chegowia"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# Agente de IA — camada abstrata, troque o provider sem mudar código
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# WhatsApp Fase 1 (sem API oficial, apenas link wa.me) — número default de fallback
DEFAULT_WHATSAPP_COUNTRY_CODE="55"

# ---- apps/web ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
