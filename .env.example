# Desenvolvimento local. Copie para .env e nunca versione valores reais.
NODE_ENV=development
TZ=America/Sao_Paulo
BUSINESS_TIMEZONE=America/Sao_Paulo

# MySQL / Docker de desenvolvimento
MYSQL_ROOT_PASSWORD=troque-no-seu-ambiente
MYSQL_DATABASE=chegowia
MYSQL_USER=chegowia
MYSQL_PASSWORD=troque-no-seu-ambiente
MYSQL_PORT=3306
ADMINER_PORT=8090
DATABASE_URL=mysql://chegowia:troque-no-seu-ambiente@localhost:3306/chegowia

# API
HOST=0.0.0.0
PORT=3001
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=chegowia-api
JWT_AUDIENCE=chegowia-web
# MFA é obrigatório para todas as contas reais em produção. Em desenvolvimento
# a aplicação também segue a mesma regra para testar o fluxo completo.
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN,FUNCIONARIO,COZINHA,MOTOBOY,GARCOM,CLIENTE,REVENDEDOR
BILLING_ENFORCEMENT=false

# Login multiacesso: UM único e-mail pode escolher, após entrar, se acessa como
# plataforma ou como ADMIN de uma empresa. Fica em variável de ambiente de
# propósito — assim esse privilégio não se concede pelo painel, só com acesso ao
# servidor. Vazio desliga o recurso para todo mundo.
#
# A conta ainda precisa ser SUPER_ADMIN: o e-mail sozinho não basta.
MULTI_CONTEXT_LOGIN_EMAIL=

# Arquivos locais
UPLOAD_ROOT=./apps/api/uploads
PRIVATE_UPLOAD_ROOT=./apps/api/private_uploads
CLAMAV_SCAN_ENABLED=false
CLAMAV_COMMAND=clamdscan
CLAMAV_TIMEOUT_MS=30000
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb

# Geografia e rota de entrega. Em produção, use um provedor contratado ou uma
# instância própria; os endpoints públicos abaixo servem apenas para baixo volume.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
ROUTING_BASE_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_USER_AGENT=ChegowIA/1.0 (contato@exemplo.com)
GEOCODING_MIN_INTERVAL_MS=1100
GEOGRAPHY_REQUEST_TIMEOUT_MS=8000

# Papel do processo: all (padrão, HTTP + jobs), api (só HTTP) ou worker (só
# jobs). Em produção o compose sobe api e worker separados; deixe vazio aqui.
APP_ROLE=

# Relato de erro para fora da máquina. Sem SENTRY_DSN nada é enviado e o
# comportamento é o de antes: o erro fica só no log do container.
# Corpo de requisição, cabeçalho, cookie e dado de usuário são removidos antes do
# envio — o que viaja é o rastro de pilha e o identificador da requisição.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=

# E-mail; em desenvolvimento sem SMTP os links aparecem somente no log da API
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ChegowIA <contato@chegowia.com.br>
# Caixa da equipe de operação: recebe os alertas de evento Stripe e repasse que
# esgotaram as tentativas. Obrigatório em produção.
OPS_ALERT_EMAIL=

# Inteligência artificial
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# WhatsApp via Gupshup (BSP) — único provedor do canal.
# Quem responde à Meta pelo aplicativo é o Gupshup, então a plataforma não
# depende de App Review próprio para colocar um cliente no ar. Para número já
# usado no WhatsApp Business, prepare o link em modo COEXISTÊNCIA ("Connect a
# WhatsApp Business app"): assim ele segue disponível no celular e na Central.
#
# A chave de criptografia abaixo é obrigatória: é ela que cifra o token de cada
# aplicativo em repouso. Trocá-la torna ilegíveis os canais já conectados.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
GUPSHUP_ENABLED=false
# SELF_SERVE usa a conta comum do gupshup.io: uma apikey só, e o app de cada
# cliente é criado à mão no painel deles (o cliente conclui o cadastro por um
# link, sem você acessar o Facebook dele). PARTNER automatiza a criação do app,
# mas exige aprovação no partner program — que por sua vez exige o Tech Provider
# Program da Meta. Comece em SELF_SERVE.
GUPSHUP_MODE=SELF_SERVE
GUPSHUP_API_BASE_URL=https://api.gupshup.io
GUPSHUP_API_KEY=
# Somente no modo PARTNER:
GUPSHUP_PARTNER_API_BASE_URL=https://partner.gupshup.io/partner
GUPSHUP_PARTNER_EMAIL=
GUPSHUP_PARTNER_PASSWORD=
# O Gupshup não assina o corpo do callback como a Meta faz com
# x-hub-signature-256. Este segredo viaja na URL registrada na Partner API e é
# o que autentica o webhook. Gere com: openssl rand -hex 32
GUPSHUP_WEBHOOK_TOKEN=

# Fiscal — cifra o certificado digital A1 e o CSC em repouso.
# Chave PRÓPRIA, distinta da do WhatsApp: aqui mora a chave privada com a qual
# se assina documento fiscal em nome da empresa. Gere com: openssl rand -base64 32
FISCAL_ENCRYPTION_KEY=

# Observabilidade — token exigido para raspar /api/health/metrics.
# Vazio desabilita a rota; sem ele qualquer um veria volume de pedidos e latência.
METRICS_TOKEN=

# Provedor de cobrança para contratações novas: ASAAS ou STRIPE.
# Assinatura já criada na Stripe continua sendo cobrada por ela mesmo depois de
# trocar esta chave — só as contratações seguintes mudam de provedor.
BILLING_PROVIDER=ASAAS

# Asaas — a chave carrega o ambiente: $aact_hmlg_ responde só no sandbox e
# $aact_prod_ só em produção. Não é preciso informar a URL.
ASAAS_API_KEY=
# Token definido ao criar o webhook no painel do Asaas. É a única prova de
# origem do callback: o Asaas não assina o corpo como a Stripe.
ASAAS_WEBHOOK_TOKEN=
# Opcional. Cifra a chave da subconta do revendedor (32 bytes em base64 ou hex).
# Sem ela a chave é descartada em vez de guardada em texto claro; o repasse
# continua funcionando, pois sai da conta raiz.
ASAAS_SUBACCOUNT_ENCRYPTION_KEY=
# Só em homologação: permite subir com chave de sandbox marcando produção.
# ALLOW_ASAAS_SANDBOX_IN_PRODUCTION=true

# Revenda no Asaas: o teste termina em 7 dias; a comissão só é liberada quando
# a cobrança muda para PAYMENT_RECEIVED, isto é, quando o saldo entrou na conta
# raiz. Em cartão isso pode levar cerca de 32 dias. Use esta variável apenas se
# quiser uma reserva EXTRA depois do crédito efetivo; o padrão não adiciona uma
# segunda carência ao revendedor.
ASAAS_COMMISSION_POST_RECEIPT_HOLD_DAYS=0

# Assinaturas legadas da Stripe conservam a reserva histórica de 7 dias.
STRIPE_COMMISSION_HOLD_DAYS=7

# Stripe — obrigatória apenas enquanto BILLING_PROVIDER=STRIPE ou houver
# assinatura antiga ainda cobrada por ela.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# URL canônica do site público. Em produção use https://chegowia.com.br.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL privada/opcional para o servidor Next buscar a API (ex.: http://api:3001).
API_INTERNAL_URL=http://localhost:3001
# Cole aqui a verificação emitida pelo Google Search Console, sem a tag HTML.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
DEFAULT_WHATSAPP_COUNTRY_CODE=55
